---
// SubNav.astro — the primary nav for subpages (industry/solution pages).
// Same structure, links, and dropdown behavior as the landing hero nav, but on
// a solid dark band (the white "nairon." wordmark needs a dark ground) instead
// of floating over the hero photo. Driven by the shared NAV model.
import { NAV, isExternal } from "../../data/nav";
---

<header class="subnav w-full" style="background-color: #0B0D12; box-sizing: border-box; position: relative; z-index: 40;">
  <div
    class="mx-auto w-full max-w-[1440px] px-5 md:px-10 lg:px-[64px] py-[22px]"
    style="align-items: center; box-sizing: border-box; display: flex; justify-content: space-between;"
  >
    <!-- Logo -->
    <div class="min-w-0 shrink-0 flex items-center lg:w-[240px]" style="box-sizing: border-box;">
      <a href="/" aria-label="Nairon home" style="box-sizing: border-box; display: block;">
        <div
          style="background-image: url(/paper/0VG8PRRSWYZ4M872HN6J7RD0CG.webp); background-position: 50%; background-repeat: no-repeat; background-size: contain; box-sizing: border-box; flex-shrink: 0; height: 26px; width: 108px;"
        >
        </div>
      </a>
    </div>

    <!-- Center links (desktop only): dropdown parents + direct links -->
    <nav class="hidden lg:flex" style="align-items: center; box-sizing: border-box; gap: 30px;" aria-label="Primary">
      {
        NAV.map((item) => {
          if (!item.items) {
            return (
              <a
                href={item.href}
                class="nav-link"
                {...(isExternal(item.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {item.label}
              </a>
            );
          }
          const grid = item.items.length > 3;
          const rows = Math.ceil(item.items.length / 2);
          return (
            <div class="nav-item">
              <button type="button" class="nav-trigger" aria-haspopup="true">
                {item.label}
                <svg class="nav-chevron" width="9" height="9" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 3.5L5 6.5l3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="nav-pop">
                <div
                  class={`nav-pop-panel${grid ? " nav-pop-panel--grid" : ""}`}
                  style={grid ? `grid-template-rows: repeat(${rows}, auto);` : ""}
                >
                  {item.items.map((leaf) => (
                    <a href={leaf.href} class="nav-pop-link">
                      {leaf.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <!-- Right cluster: CTA (always) + hamburger (mobile/tablet) -->
    <div class="min-w-0 shrink-0 flex items-center justify-end gap-3 md:gap-4 lg:gap-[22px] lg:w-[240px]" style="box-sizing: border-box;">
      <a
        href="/#book"
        style="align-items: center; border-color: #FFFFFF57; border-radius: 40px; border-style: solid; border-width: 1px; box-sizing: border-box; display: flex; padding-block: 9px; padding-inline: 18px; text-decoration: none; transition: background-color 0.18s ease, border-color 0.18s ease;"
        onmouseover="this.style.backgroundColor='#FFFFFF14';this.style.borderColor='#FFFFFF8C';"
        onmouseout="this.style.backgroundColor='transparent';this.style.borderColor='#FFFFFF57';"
      >
        <div style="box-sizing: border-box; color: #FFFFFF; display: flex; font-family: 'Geist', system-ui, sans-serif; font-size: 14px; font-weight: 500; line-height: 18px; white-space: nowrap;">
          Book an AI audit
        </div>
      </a>

      <!-- Hamburger menu (mobile + tablet only), CSS-only via <details> -->
      <details class="lg:hidden relative" style="box-sizing: border-box;">
        <summary
          class="list-none flex items-center justify-center cursor-pointer"
          style="width: 40px; height: 40px; border: 1px solid #FFFFFF57; border-radius: 10px; box-sizing: border-box;"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 z-10 flex flex-col"
          style="min-width: 232px; max-height: 72vh; overflow-y: auto; background-color: #0B0D12F2; border: 1px solid #FFFFFF1F; border-radius: 12px; padding: 12px; gap: 2px; box-sizing: border-box; backdrop-filter: blur(8px);"
        >
          {
            NAV.map((item) =>
              item.items ? (
                <>
                  <div style="box-sizing: border-box; color: #FFFFFF61; font-family: 'Geist Mono', system-ui, sans-serif; font-size: 10.5px; letter-spacing: 0.16em; line-height: 14px; padding: 12px 6px 4px; text-transform: uppercase;">
                    {item.label}
                  </div>
                  {item.items.map((leaf) => (
                    <a href={leaf.href} style="box-sizing: border-box; color: #FFFFFFC2; font-family: 'Geist', system-ui, sans-serif; font-size: 14.5px; font-weight: 500; line-height: 18px; padding: 8px 6px; text-decoration: none;">
                      {leaf.label}
                    </a>
                  ))}
                </>
              ) : (
                <a
                  href={item.href}
                  style="box-sizing: border-box; color: #FFFFFFE0; font-family: 'Geist', system-ui, sans-serif; font-size: 15px; font-weight: 500; line-height: 18px; padding: 12px 6px 8px; text-decoration: none;"
                  {...(isExternal(item.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {item.label}
                </a>
              ),
            )
          }
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  /* Same dropdown system as the hero nav: hover OR keyboard focus reveals a
     dark frosted panel; an invisible top-padding "bridge" keeps hover continuous. */
  .nav-trigger,
  .nav-link {
    align-items: center;
    background: none;
    border: none;
    box-sizing: border-box;
    color: #ffffffe0;
    cursor: pointer;
    display: inline-flex;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    gap: 5px;
    line-height: 18px;
    padding: 0;
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .nav-trigger:hover,
  .nav-link:hover,
  .nav-item:focus-within .nav-trigger {
    color: #ffffff;
  }
  .nav-trigger:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid #ffffffb0;
    outline-offset: 4px;
    border-radius: 3px;
  }
  .nav-chevron {
    color: #ffffff99;
    flex-shrink: 0;
    transition: transform 0.22s ease, color 0.18s ease;
  }
  .nav-item {
    box-sizing: border-box;
    position: relative;
  }
  .nav-item:hover .nav-chevron,
  .nav-item:focus-within .nav-chevron {
    color: #ffffff;
    transform: rotate(180deg);
  }

  .nav-pop {
    box-sizing: border-box;
    left: 0;
    opacity: 0;
    padding-top: 12px; /* invisible hover bridge to the panel */
    pointer-events: none;
    position: absolute;
    top: 100%;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0.2s;
    visibility: hidden;
    z-index: 50;
  }
  .nav-item:hover .nav-pop,
  .nav-item:focus-within .nav-pop {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    visibility: visible;
  }
  .nav-pop-panel {
    backdrop-filter: blur(10px);
    background-color: #0b0d12f2;
    border: 1px solid #ffffff1f;
    border-radius: 14px;
    box-shadow: 0 22px 54px -14px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 244px;
    padding: 10px;
  }
  /* 2-column layout for groups with >3 items (fills column-major). */
  .nav-pop-panel--grid {
    display: grid;
    grid-auto-flow: column;
    column-gap: 10px;
    row-gap: 2px;
    min-width: 440px;
  }
  .nav-pop-link {
    border-radius: 8px;
    box-sizing: border-box;
    color: #ffffffc2;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    padding: 9px 12px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .nav-pop-link:hover,
  .nav-pop-link:focus-visible {
    background-color: #ffffff14;
    color: #ffffff;
    outline: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-pop,
    .nav-chevron,
    .nav-pop-link,
    .nav-trigger,
    .nav-link {
      transition: none !important;
    }
  }
</style>
