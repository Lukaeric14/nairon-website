<style>
  /* Workspace ticket — stacked (overlapping) avatar group so it stays one row. */
  .s2-avatars { flex-wrap: nowrap !important; gap: 0 !important; }
  .s2-avatar { margin-left: -5px; box-shadow: 0 0 0 1.5px #ffffff; }
  .s2-avatar:first-child { margin-left: 0; }
</style>

<script>
  import gsap from 'gsap';

  // ── "Platform & Services" (Section 2) card animations ──────────────────────
  // Card 1 (AI Agents): the agent's work reveals sequentially (Checking Notion →
  // Checking Exa → Thinking about next steps). Card 2 (AI Workspace): a ticket
  // comes in ("Lease expiring for 245 Halfday"), then the reply count climbs and
  // the avatar group grows as agents + people join the thread.
  // Mobile / reduced-motion: everything is visible, no animation.
  function initSection2() {
    const root = document.querySelector<HTMLElement>('[data-s2]');
    if (!root) return;
    // Runs on ALL breakpoints (mobile + desktop); only prefers-reduced-motion opts out.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const agEntries = Array.from(root.querySelectorAll<HTMLElement>('.s2-ag'));
    const ticket = root.querySelector<HTMLElement>('.s2-ticket');
    const repliesEl = root.querySelector<HTMLElement>('.s2-replies');
    const avatars = Array.from(root.querySelectorAll<HTMLElement>('.s2-avatar'));

    let started = false;
    const setup = () => {
      gsap.set(agEntries, { opacity: 0, y: 12 });
      if (ticket) gsap.set(ticket, { opacity: 0, y: -8 });
      gsap.set(avatars, { opacity: 0, scale: 0.4 });
      if (repliesEl) repliesEl.textContent = '1 reply';

      const play = () => {
        if (started) return;
        started = true;
        const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        // Card 1 — agent work reveals sequentially (3 entries, done by ~2.25s).
        tl.to(agEntries, { opacity: 1, y: 0, duration: 0.55, stagger: 0.7 }, 0.3);
        // Card 2 — starts only AFTER Card 1 has finished.
        const c2 = 2.5;
        if (ticket) tl.to(ticket, { opacity: 1, y: 0, duration: 0.5 }, c2);
        // Reply count climbs.
        const counter = { n: 1 };
        tl.to(counter, {
          n: 14,
          duration: 2.8,
          ease: 'power1.inOut',
          onUpdate: () => {
            const v = Math.round(counter.n);
            if (repliesEl) repliesEl.textContent = v + (v === 1 ? ' reply' : ' replies');
          },
        }, c2 + 0.6);
        // Agents + people join the thread — avatars appear one by one.
        tl.to(avatars, { opacity: 1, scale: 1, duration: 0.4, stagger: 0.48, ease: 'back.out(1.7)' }, c2 + 0.8);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { play(); io.disconnect(); }
        },
        { threshold: 0.25 },
      );
      io.observe(root);
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setup);
    else setup();
  }
  initSection2();
</script>
