---
// Nav.astro — the site's sticky top nav.
//
// Behaviour:
//   • Fixed to the top, overlaying the hero. Transparent with white text at the
//     very top; on scroll it gains a white frosted background and the text +
//     logo + CTA flip to dark (toggled by the `.is-scrolled` class from JS).
//   • Dropdown parents (Solutions / AI Training) reveal a panel on hover OR
//     keyboard focus (pure CSS). Groups with >3 items render 2 columns.
//   • Mobile/tablet collapse into a CSS-only <details> menu.
//
// The NAV model lives in src/data/nav.ts — edit there to change the nav
// everywhere. Dropdown contents mirror the footer link groups; groups with
// >3 items render as 2 columns.
//
// `solid` (solution/subpages): the bar starts — and stays — in its
// white/dark-text state, for pages whose top is white instead of a dark hero.
import { NAV, isExternal } from "../../data/nav";

export interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
---

<header class={`site-nav${solid ? " site-nav--solid is-scrolled" : ""}`} data-testid="site-nav">
  <div
    class="site-nav-inner mx-auto w-full max-w-[1440px] px-5 md:px-10 lg:px-[64px]"
    style="align-items: center; box-sizing: border-box; display: flex; justify-content: space-between;"
  >
    <!-- Logo -->
    <div class="min-w-0 shrink-0 flex items-center lg:w-[240px]" style="box-sizing: border-box;">
      <a href="/" aria-label="Nairon home" style="box-sizing: border-box; display: block;">
        <div
          class="site-nav-logo"
          style="background-image: url(/paper/0VG8PRRSWYZ4M872HN6J7RD0CG.webp); background-position: left center; background-repeat: no-repeat; background-size: contain; box-sizing: border-box; flex-shrink: 0; height: 26px; width: 108px;"
        >
        </div>
      </a>
    </div>

    <!-- Center links (desktop only): dropdown parents + direct links -->
    <nav class="site-nav-links hidden lg:flex" style="align-items: center; box-sizing: border-box; gap: 30px;" aria-label="Primary">
      {
        NAV.map((item) => {
          if (!item.items) {
            return (
              <a
                href={item.href}
                class="nav-link"
                {...(isExternal(item.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {item.label}
              </a>
            );
          }
          const grid = item.items.length > 3;
          const rows = Math.ceil(item.items.length / 2);
          return (
            <div class="nav-item">
              <button type="button" class="nav-trigger" aria-haspopup="true">
                {item.label}
                <svg class="nav-chevron" width="9" height="9" viewBox="0 0 10 10" xmlns="http://www.w3.org/2000/svg">
                  <path d="M2 3.5L5 6.5l3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <div class="nav-pop">
                <div
                  class={`nav-pop-panel${grid ? " nav-pop-panel--grid" : ""}`}
                  style={grid ? `grid-template-rows: repeat(${rows}, auto);` : ""}
                >
                  {item.items.map((leaf) => (
                    <a href={leaf.href} class="nav-pop-link">
                      {leaf.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </nav>

    <!-- Right cluster: CTA (always) + hamburger (mobile/tablet) -->
    <div
      class="min-w-0 shrink-0 flex items-center justify-end gap-3 md:gap-4 lg:gap-[22px] lg:w-[240px]"
      style="box-sizing: border-box;"
    >
      <a href="/#book" class="site-nav-cta">Book an AI audit</a>

      <!-- Hamburger menu (mobile + tablet only), CSS-only via <details> -->
      <details class="lg:hidden relative" style="box-sizing: border-box;">
        <summary class="site-nav-burger list-none flex items-center justify-center cursor-pointer">
          <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 mt-2 z-10 flex flex-col"
          style="min-width: 232px; max-height: 72vh; overflow-y: auto; background-color: #0B0D12F2; border: 1px solid #FFFFFF1F; border-radius: 12px; padding: 12px; gap: 2px; box-sizing: border-box; backdrop-filter: blur(8px);"
        >
          {
            NAV.map((item) =>
              item.items ? (
                <>
                  <div style="box-sizing: border-box; color: #FFFFFF61; font-family: 'Geist Mono', system-ui, sans-serif; font-size: 10.5px; letter-spacing: 0.16em; line-height: 14px; padding: 12px 6px 4px; text-transform: uppercase;">
                    {item.label}
                  </div>
                  {item.items.map((leaf) => (
                    <a href={leaf.href} style="box-sizing: border-box; color: #FFFFFFC2; font-family: 'Geist', system-ui, sans-serif; font-size: 14.5px; font-weight: 500; line-height: 18px; padding: 8px 6px; text-decoration: none;">
                      {leaf.label}
                    </a>
                  ))}
                </>
              ) : (
                <a
                  href={item.href}
                  style="box-sizing: border-box; color: #FFFFFFE0; font-family: 'Geist', system-ui, sans-serif; font-size: 15px; font-weight: 500; line-height: 18px; padding: 12px 6px 8px; text-decoration: none;"
                  {...(isExternal(item.href) ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                >
                  {item.label}
                </a>
              ),
            )
          }
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Flip the nav to its solid/dark state once the page scrolls off the hero top.
  // Solid pages (white top, no dark hero) start scrolled and stay that way.
  function initNav() {
    const nav = document.querySelector<HTMLElement>(".site-nav");
    if (!nav) return;
    if (nav.classList.contains("site-nav--solid")) return;
    const onScroll = () => {
      nav.classList.toggle("is-scrolled", window.scrollY > 24);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
  initNav();
</script>

<style>
  /* ── Fixed sticky bar ─────────────────────────────────────────────────────── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    box-sizing: border-box;
    background-color: transparent;
    transition: background-color 0.28s ease, box-shadow 0.28s ease;
    animation: navIn 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) 0.1s both;
  }
  @keyframes navIn {
    from { opacity: 0; transform: translateY(-10px); }
    to   { opacity: 1; transform: none; }
  }
  .site-nav-inner {
    padding-top: 18px;
    padding-bottom: 18px;
  }
  /* Scrolled: white frosted bar + hairline/shadow. */
  .site-nav.is-scrolled {
    background-color: #fffffff2;
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 0 rgba(11, 13, 18, 0.06), 0 12px 30px -22px rgba(11, 13, 18, 0.4);
  }
  .site-nav-logo {
    transition: filter 0.28s ease;
  }
  .site-nav.is-scrolled .site-nav-logo {
    filter: brightness(0); /* white wordmark → black on the white bar */
  }

  /* ── Triggers + direct links ──────────────────────────────────────────────── */
  .nav-trigger,
  .nav-link {
    align-items: center;
    background: none;
    border: none;
    box-sizing: border-box;
    color: #ffffffe0;
    cursor: pointer;
    display: inline-flex;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    gap: 5px;
    line-height: 18px;
    padding: 0;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .nav-trigger:hover,
  .nav-link:hover,
  .nav-item:focus-within .nav-trigger {
    color: #ffffff;
  }
  .nav-trigger:focus-visible,
  .nav-link:focus-visible {
    outline: 2px solid #ffffffb0;
    outline-offset: 4px;
    border-radius: 3px;
  }
  .nav-chevron {
    color: #ffffff99;
    flex-shrink: 0;
    transition: transform 0.22s ease, color 0.2s ease;
  }
  .nav-item {
    box-sizing: border-box;
    position: relative;
  }
  .nav-item:hover .nav-chevron,
  .nav-item:focus-within .nav-chevron {
    color: #ffffff;
    transform: rotate(180deg);
  }
  /* Scrolled text colours. */
  .site-nav.is-scrolled .nav-trigger,
  .site-nav.is-scrolled .nav-link {
    color: #14171f;
  }
  .site-nav.is-scrolled .nav-trigger:hover,
  .site-nav.is-scrolled .nav-link:hover,
  .site-nav.is-scrolled .nav-item:focus-within .nav-trigger {
    color: #000000;
  }
  .site-nav.is-scrolled .nav-chevron {
    color: #14171f80;
  }
  .site-nav.is-scrolled .nav-item:hover .nav-chevron,
  .site-nav.is-scrolled .nav-item:focus-within .nav-chevron {
    color: #14171f;
  }
  .site-nav.is-scrolled .nav-trigger:focus-visible,
  .site-nav.is-scrolled .nav-link:focus-visible {
    outline-color: #0f6bd4;
  }

  /* ── Dropdown panel (hover / focus reveal, with hover bridge) ─────────────── */
  .nav-pop {
    box-sizing: border-box;
    left: 0;
    opacity: 0;
    padding-top: 14px; /* invisible bridge from trigger to panel */
    pointer-events: none;
    position: absolute;
    top: 100%;
    transform: translateY(6px);
    transition:
      opacity 0.2s ease,
      transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1),
      visibility 0.2s;
    visibility: hidden;
    z-index: 60;
  }
  .nav-item:hover .nav-pop,
  .nav-item:focus-within .nav-pop {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    visibility: visible;
  }
  .nav-pop-panel {
    backdrop-filter: blur(10px);
    background-color: #0b0d12f2;
    border: 1px solid #ffffff1f;
    border-radius: 14px;
    box-shadow: 0 22px 54px -14px rgba(0, 0, 0, 0.6);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 244px;
    padding: 10px;
  }
  /* 2-column layout for groups with >3 items (fills column-major). */
  .nav-pop-panel--grid {
    display: grid;
    grid-auto-flow: column;
    column-gap: 10px;
    row-gap: 2px;
    min-width: 440px;
  }
  .nav-pop-link {
    border-radius: 8px;
    box-sizing: border-box;
    color: #ffffffc2;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    padding: 9px 12px;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
    white-space: nowrap;
  }
  .nav-pop-link:hover,
  .nav-pop-link:focus-visible {
    background-color: #ffffff14;
    color: #ffffff;
    outline: none;
  }
  /* Scrolled: light dropdown panel to match the white bar. */
  .site-nav.is-scrolled .nav-pop-panel {
    background-color: #fffffff7;
    border-color: #00000012;
    box-shadow: 0 22px 54px -18px rgba(11, 13, 18, 0.24);
  }
  .site-nav.is-scrolled .nav-pop-link {
    color: #2b3038;
  }
  .site-nav.is-scrolled .nav-pop-link:hover,
  .site-nav.is-scrolled .nav-pop-link:focus-visible {
    background-color: #14171f0a;
    color: #0b0d12;
  }

  /* ── CTA pill ─────────────────────────────────────────────────────────────── */
  .site-nav-cta {
    align-items: center;
    background-color: transparent;
    border: 1px solid #ffffff57;
    border-radius: 40px;
    box-sizing: border-box;
    color: #ffffff;
    display: flex;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 18px;
    padding: 9px 18px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .site-nav-cta:hover {
    background-color: #ffffff14;
    border-color: #ffffff8c;
  }
  .site-nav.is-scrolled .site-nav-cta {
    background-color: #14171f;
    border-color: #14171f;
    color: #ffffff;
  }
  .site-nav.is-scrolled .site-nav-cta:hover {
    background-color: #000000;
    border-color: #000000;
  }

  /* ── Hamburger ────────────────────────────────────────────────────────────── */
  .site-nav-burger {
    width: 40px;
    height: 40px;
    border: 1px solid #ffffff57;
    border-radius: 10px;
    box-sizing: border-box;
    color: #ffffff;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .site-nav.is-scrolled .site-nav-burger {
    border-color: #14171f26;
    color: #14171f;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      animation: none !important;
    }
    .nav-pop,
    .nav-chevron,
    .nav-pop-link,
    .nav-trigger,
    .nav-link,
    .site-nav-cta,
    .site-nav-logo {
      transition: none !important;
    }
  }
</style>
