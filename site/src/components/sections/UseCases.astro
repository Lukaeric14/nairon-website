<style>
  /* ============================================================
     UseCases responsive layer.

     Strategy (first principles):
     - Below 1024px the layout REFLOWS, it does not zoom. Each row
       stacks (text, then the image "stage"). The glass panel stays ON
       the photo at EVERY breakpoint: the photo fills the stage as a
       background layer and the panel floats over it in normal flow,
       centered inside the stage's padding frame. Panels stay readable
       at real type sizes; the wide "Accounts" table scrolls
       horizontally inside its own card so the page never scrolls.
     - At >=1024px (lg) we restore the ORIGINAL Paper design
       PIXEL-FOR-PIXEL: two-column rows, the glass panels absolutely
       positioned over a 618px-tall photo at their exact coordinates.
       Every desktop-only value lives behind @media (min-width:1024px),
       so nothing below lg can touch the desktop render.
     - Zero fixed page-driving widths: no 618/730/1440/1680px in the
       base/tablet layers. Desktop pins those values, gated by lg.
     ============================================================ */

  /* ---- ROOT: full-bleed dark/white section, fluid padding ---- */
  .uc-root {
    width: 100%;
    /* fluid section padding — desktop max = original 96px block / 72px inline */
    padding-block: clamp(56px, 12vw, 96px);
    padding-inline: 20px;
    gap: 60px;
  }

  /* ---- CONTAINER: centered, capped so it stays put on wide screens
     while the section bg fills edge-to-edge. Desktop pins the original
     1680 cap (content never exceeds it at 1440, so 1440 is identical). ---- */
  .uc-container {
    max-width: 1296px;
    margin-inline: auto;
    gap: 0;
  }

  /* ---- HEADER ---- */
  .uc-header {
    padding-bottom: clamp(40px, 8vw, 72px);
  }
  .uc-h2 {
    font-size: clamp(30px, 7vw, 48px);
  }
  .uc-sub {
    font-size: clamp(15px, 3.6vw, 17px);
  }

  /* ---- ROWS: stack vertically; fluid gap between rows ---- */
  .uc-rows {
    gap: clamp(72px, 16vw, 160px);
  }

  /* ---- ROW INNER: stacked (column) on mobile, photo above panel ---- */
  .uc-row-inner {
    flex-direction: column;
    gap: clamp(28px, 6vw, 44px);
    align-items: stretch;
  }
  /* Row 2's source order is image-first; keep it stacked the same way
     (text -> photo -> panel) below lg for a consistent reading rhythm. */
  .uc-row-rev {
    flex-direction: column;
  }

  /* ---- TEXT COLUMN ---- */
  .uc-textcol {
    width: 100%;
    min-width: 0;
    gap: 28px;
  }
  .uc-rowtitle {
    font-size: clamp(26px, 6.4vw, 36px);
    line-height: 1.2;
  }
  .uc-rowbody { max-width: 520px; }
  .uc-substeps { max-width: 532px; }

  /* ---- IMAGE COLUMN ----
     A normal full-width column. It holds the photo banner and, stacked
     beneath it, the glass panel — both fluid. No fixed width, no zoom. ---- */
  .uc-imgcol {
    width: 100%;
    min-width: 0;
  }

  /* ---- STAGE: a positioned frame at EVERY breakpoint. The photo fills it
     as a background layer; the glass panel sits IN-FLOW on top, centered,
     with the stage's padding forming a photo "frame" around it. The panel
     therefore floats OVER the photo (like desktop) and the photo's height
     follows the panel — so it can never overflow or get clipped short. ---- */
  .uc-stage {
    display: block;
    position: relative;
    width: 100%;
    min-width: 0;
    min-height: 300px;
    overflow: clip;
    border-radius: 12px;
    padding: 44px 16px; /* the visible photo frame around the panel */
  }

  /* Photo fills the whole stage, behind the panel. */
  .uc-photo {
    position: absolute !important;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: auto;
    border-radius: 0;
    order: 0;
    z-index: 0;
    object-fit: cover;
    object-position: 50%;
  }

  /* Window-dots chip: pinned to the top-left corner of the photo. */
  .uc-dots {
    position: absolute !important;
    top: 16px !important;
    left: 16px !important;
    z-index: 2;
  }

  /* Glass panels: float OVER the photo. In normal flow (so they set the
     stage height), centered, capped for readability — never detached below
     the image. */
  .uc-panel {
    position: relative !important;
    inset: auto !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    bottom: auto !important;
    z-index: 1;
    width: 100% !important;
    max-width: 360px !important;
    margin: 0 auto !important;
    box-sizing: border-box;
  }

  /* The wide "Accounts" table: its rows keep their intrinsic ~730px width
     (fixed AGENT/REQUEST columns). It floats on the photo too, and scrolls
     horizontally INSIDE the card so the document never gains a scrollbar. */
  .uc-table-panel {
    overflow-x: auto !important;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }
  .uc-table-panel > div {
    min-width: max-content;
  }

  /* ============================================================
     TABLET (>=768px, <1024px): still stacked, but center the column
     content and give panels a touch more room + more inline padding.
     ============================================================ */
  @media (min-width: 768px) {
    .uc-root { padding-inline: 40px; }
    .uc-row-inner { align-items: center; }
    .uc-textcol { align-self: center; max-width: 640px; }
    .uc-imgcol {
      max-width: 640px;
      margin-inline: auto;
      align-self: center;
    }
    /* more photo shows around a slightly larger floating panel */
    .uc-stage { min-height: 460px; padding: 64px 28px; }
    .uc-panel { max-width: 420px !important; }
    .uc-table-panel { max-width: 560px !important; }
  }

  /* ============================================================
     DESKTOP (>=1024px / lg): restore the ORIGINAL pixel-perfect
     design. Everything below returns each element to its source
     values so the rendered result is byte-identical to the
     original component at >=1024px.
     ============================================================ */
  @media (min-width: 1024px) {
    .uc-root {
      padding-block: 96px;
      padding-inline: 72px;
      gap: 60px;
      align-content: center;
      justify-content: flex-start;
      height: min-content;
    }
    .uc-container {
      max-width: 1440px;
      flex-shrink: 0;
      height: min-content;
    }
    .uc-header {
      gap: 20px;
      padding-bottom: 72px;
    }
    .uc-h2 {
      font-size: 48px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      line-height: 106%;
    }
    .uc-sub {
      font-size: 17px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }
    .uc-rows {
      gap: 160px;
      flex-shrink: 0;
      height: min-content;
      overflow: clip;
    }
    .uc-row { flex-shrink: 0; }
    .uc-row-inner {
      flex-direction: row;
      align-content: flex-start;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 60px;
      height: min-content;
    }
    .uc-row-rev { flex-direction: row; }
    .uc-textcol {
      align-content: flex-start;
      align-items: flex-start;
      align-self: stretch;
      flex-basis: 0px;
      flex-grow: 1;
      flex-shrink: 0;
      justify-content: space-between;
      width: 1px;
      gap: 0;
    }
    .uc-rowtitle {
      font-size: 36px;
      line-height: 43.2px;
      letter-spacing: -0.72px;
    }
    .uc-rowbody { max-width: 70%; width: 378px; }
    .uc-substeps { max-width: 532px; }
    .uc-imgcol {
      aspect-ratio: 1 / 1;
      flex-basis: 0px;
      flex-grow: 1;
      flex-shrink: 0;
      width: 0px;
      max-width: none;
      margin-inline: 0;
      align-self: auto;
      display: flex;
      flex-direction: column;
    }
    /* Stage returns to the original positioned square that fills the column
       (position:relative + overflow:clip come from the element's inline style;
       we only need to undo the base flex-stack). */
    .uc-stage {
      display: block;
      gap: 0;
      overflow: clip !important;
      position: relative;
      width: 100%;
      height: 100%;
      flex: 1 1 auto;
    }
    /* Photo returns to the full-bleed 618px-tall background layer. */
    .uc-photo {
      position: static;
      width: 100% !important;
      height: 618px !important;
      aspect-ratio: auto;
      border-radius: 0;
      order: 0;
      flex-shrink: 0;
    }
    /* Dots return to original absolute coords (top:20px; left:20px). */
    .uc-dots {
      top: 20px !important;
      left: 20px !important;
    }
    /* Panels return to absolute positioning at their exact source coords. */
    .uc-panel {
      position: absolute !important;
      max-width: none;
      margin-inline: 0;
    }
    .uc-panel-chat {
      right: 28px !important;
      top: 34px !important;
      left: auto !important;
      width: 384px !important;
    }
    .uc-panel-dispatch {
      left: 30px !important;
      top: 74px !important;
      right: auto !important;
      width: 372px !important;
    }
    .uc-table-panel {
      left: 144px !important;
      top: 114px !important;
      right: auto !important;
      width: 720px !important;
      max-width: none !important;
      overflow: clip !important;
    }
    .uc-table-panel > div {
      min-width: 0;
    }
  }

  /* Use Cases — simple small "working" dots (subtle opacity only, no motion). */
  .uc1-dots span,
  .uc2-dots span {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background-color: #9AA0AC;
    animation: uc1DotPulse 1.3s ease-in-out infinite;
  }
  .uc1-dots span:nth-child(2),
  .uc2-dots span:nth-child(2) { animation-delay: 0.22s; }
  .uc1-dots span:nth-child(3),
  .uc2-dots span:nth-child(3) { animation-delay: 0.44s; }
  @keyframes uc1DotPulse {
    0%, 70%, 100% { opacity: 0.3; }
    35% { opacity: 1; }
  }
</style>

<script>
  import gsap from 'gsap';

  // ── Use Case 1 (Leasing) choreography ────────────────────────────────────────
  // On scroll-in (desktop, motion allowed) the row plays a one-time sequence:
  //   the left text loads in (title → body → WORKS WITH → "Answer every inquiry
  //   instantly") WHILE the glass panel builds itself — glass appears → avatar →
  //   "Follow up with today's leasing leads" message → file chip → EXPAND to
  //   "6 tours booked" + Replied to 14 inquiries + buttons → (~1s pause) Tours on
  //   the calendar → (~1s pause) Follow-ups scheduled. Only once the panel is
  //   complete do "Pre-qualify…" and "Follow up…" load in.
  // Mobile / reduced-motion: everything is simply visible (no hiding).
  function initUseCase1() {
    const root = document.querySelector<HTMLElement>('[data-uc1]');
    if (!root) return;
    const panel = root.querySelector<HTMLElement>('.uc-panel-chat');
    if (!panel) return;

    // Runs on ALL breakpoints (mobile + desktop); only prefers-reduced-motion
    // opts out. The choreography measures elements live, so it adapts to the
    // panel's size at any width.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return; // leave everything visible

    const t = (name: string) => root.querySelector<HTMLElement>(`[data-uc1-t="${name}"]`);
    const title = t('title'), body = t('body'), works = t('works');
    const s1 = t('s1'), s2 = t('s2'), s3 = t('s3');
    const textEls = [title, body, works, s1, s2, s3].filter(Boolean) as HTMLElement[];
    // Panel direct children, in order:
    // 0 avatar, 1 message bubble, 2 file chip, 3 nova avatar, 4 "6 tours booked",
    // 5 item 1 (Replied to inquiries), 6 item 2 (Tours), 7 item 3 (Follow-ups).
    const kids = Array.from(panel.children) as HTMLElement[];
    if (kids.length < 8) return;

    let started = false;
    const setup = () => {
      // Measure the panel height at each build phase (at natural full height).
      const top = panel.getBoundingClientRect().top;
      const bottomOf = (el: HTMLElement) => el.getBoundingClientRect().bottom - top;
      const PAD = 21; // bottom padding + border
      const H_A = bottomOf(kids[2]) + PAD; // through the file chip
      const H_status = bottomOf(kids[4]) + PAD; // through the live status line
      const H_B = bottomOf(kids[5]) + PAD; // through item 1 (Forms complete)
      const H_C = bottomOf(kids[6]) + PAD; // through item 2 (Fees)
      const H_D = bottomOf(kids[7]) + PAD; // through item 3 (Docs) — full

      // Live status line: cycles through what the agent is "doing", then settles.
      const statusEl = root.querySelector<HTMLElement>('.uc1-status');
      const dotsEl = root.querySelector<HTMLElement>('.uc1-dots');
      const setStatus = (text: string, working: boolean) => {
        if (statusEl) statusEl.textContent = text;
        if (dotsEl) dotsEl.style.display = working ? 'inline-flex' : 'none';
      };

      // Initial hidden state.
      gsap.set(textEls, { opacity: 0, y: 14 });
      gsap.set(panel, { opacity: 0, height: H_A, overflow: 'hidden' });
      gsap.set(kids, { opacity: 0 });
      gsap.set([kids[1], kids[2]], { y: 8 });
      setStatus('Reading new inquiries', true); // heading is hidden until it fades in

      const play = () => {
        if (started) return;
        started = true;
        const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        // Glass panel appears.
        tl.to(panel, { opacity: 1, duration: 0.5 }, 0.15);
        // Left text loads in (stops at "Answer every inquiry instantly").
        tl.to(title, { opacity: 1, y: 0, duration: 0.5 }, 0.0);
        tl.to(body, { opacity: 1, y: 0, duration: 0.5 }, 0.15);
        tl.to(works, { opacity: 1, y: 0, duration: 0.5 }, 0.3);
        tl.to(s1, { opacity: 1, y: 0, duration: 0.5 }, 0.5);
        // Panel phase A: avatar → message bubble → file chip.
        tl.to(kids[0], { opacity: 1, duration: 0.35 }, 0.5);
        tl.to(kids[1], { opacity: 1, y: 0, duration: 0.4 }, 0.8);
        tl.to(kids[2], { opacity: 1, y: 0, duration: 0.4 }, 1.2);
        // Phase B: expand to reveal the nova avatar + the live status line.
        tl.to(panel, { height: H_status, duration: 0.55, ease: 'power2.inOut' }, 1.9);
        tl.to([kids[3], kids[4]], { opacity: 1, duration: 0.5, stagger: 0.08 }, 2.0);
        tl.call(() => setStatus('Reading new inquiries', true), undefined, 2.05);
        tl.call(() => setStatus('Checking availability', true), undefined, 2.85);
        // Forms complete appears (result of the two searches).
        tl.to(panel, { height: H_B, duration: 0.5, ease: 'power2.inOut' }, 3.5);
        tl.to(kids[5], { opacity: 1, duration: 0.45 }, 3.6);
        tl.call(() => setStatus('Booking tours', true), undefined, 3.9);
        // ~1s → Fees calculated appears.
        tl.to(panel, { height: H_C, duration: 0.5, ease: 'power2.inOut' }, 4.6);
        tl.to(kids[6], { opacity: 1, duration: 0.45 }, 4.7);
        tl.call(() => setStatus('Scheduling follow-ups', true), undefined, 5.0);
        // ~1s → Docs attached appears.
        tl.to(panel, { height: H_D, duration: 0.5, ease: 'power2.inOut' }, 5.7);
        tl.to(kids[7], { opacity: 1, duration: 0.45 }, 5.8);
        // All three done → settle the status to "6 tours booked" (dots off).
        tl.call(() => setStatus('6 tours booked', false), undefined, 6.5);
        // Panel complete → the remaining left steps load in.
        tl.to(s2, { opacity: 1, y: 0, duration: 0.5 }, 6.9);
        tl.to(s3, { opacity: 1, y: 0, duration: 0.5 }, 7.1);
        // Release the fixed pixel height so the panel is content-driven again.
        tl.set(panel, { clearProps: 'height' }, 7.7);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { play(); io.disconnect(); }
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setup);
    else setup();
  }
  initUseCase1();

  // ── Use Case 2 (Dispatch) choreography ─────────────────────────────────────
  // The work order arrives, then the panel narrates the dispatch on a live status
  // line (Matching vendor → Sending work order → Booking window → "Vendor
  // booked"), and the vendor card, progress + buttons, and the "Dispatched by
  // Nova" confirmation build in. The left text loads in through "Dispatch the
  // right vendor"; "Track the job to closed" comes in once the panel is done.
  function initUseCase2() {
    const root = document.querySelector<HTMLElement>('[data-uc2]');
    if (!root) return;
    const panel = root.querySelector<HTMLElement>('.uc-panel-dispatch');
    if (!panel) return;

    // Runs on ALL breakpoints (mobile + desktop); only prefers-reduced-motion
    // opts out. The choreography measures elements live, so it adapts to the
    // panel's size at any width.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const t = (name: string) => root.querySelector<HTMLElement>(`[data-uc2-t="${name}"]`);
    const title = t('title'), body = t('body'), works = t('works');
    const s1 = t('s1'), s2 = t('s2');
    const textEls = [title, body, works, s1, s2].filter(Boolean) as HTMLElement[];
    // Panel direct children:
    // 0 timestamp, 1 call header, 2 status line, 3 divider, 4 tech card,
    // 5 progress/ETA, 6 buttons, 7 divider, 8 "Dispatched by Nova".
    const kids = Array.from(panel.children) as HTMLElement[];
    if (kids.length < 9) return;

    let started = false;
    const setup = () => {
      const top = panel.getBoundingClientRect().top;
      const bottomOf = (el: HTMLElement) => el.getBoundingClientRect().bottom - top;
      const PAD = 21;
      const H_A = bottomOf(kids[2]) + PAD; // through the status line
      const H_B = bottomOf(kids[4]) + PAD; // through the tech card
      const H_C = bottomOf(kids[6]) + PAD; // through the buttons
      const H_D = bottomOf(kids[8]) + PAD; // through "Dispatched by Nova" — full

      const statusEl = root.querySelector<HTMLElement>('.uc2-status');
      const dotsEl = root.querySelector<HTMLElement>('.uc2-dots');
      const setStatus = (text: string, working: boolean) => {
        if (statusEl) statusEl.textContent = text;
        if (dotsEl) dotsEl.style.display = working ? 'inline-flex' : 'none';
      };

      gsap.set(textEls, { opacity: 0, y: 14 });
      gsap.set(panel, { opacity: 0, height: H_A, overflow: 'hidden' });
      gsap.set(kids, { opacity: 0 });
      gsap.set(kids[1], { y: 8 });
      setStatus('Matching vendor', true);

      const play = () => {
        if (started) return;
        started = true;
        const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        tl.to(panel, { opacity: 1, duration: 0.5 }, 0.15);
        // Left text loads in (stops at "Dispatch the right vendor").
        tl.to(title, { opacity: 1, y: 0, duration: 0.5 }, 0.0);
        tl.to(body, { opacity: 1, y: 0, duration: 0.5 }, 0.15);
        tl.to(works, { opacity: 1, y: 0, duration: 0.5 }, 0.3);
        tl.to(s1, { opacity: 1, y: 0, duration: 0.5 }, 0.5);
        // Phase A: the work order arrives + the live matching status.
        tl.to(kids[0], { opacity: 1, duration: 0.4 }, 0.5); // timestamp
        tl.to(kids[1], { opacity: 1, y: 0, duration: 0.45 }, 0.7); // call header
        tl.to(kids[2], { opacity: 1, duration: 0.45 }, 1.1); // status line
        tl.call(() => setStatus('Matching vendor', true), undefined, 1.1);
        tl.call(() => setStatus('Sending work order', true), undefined, 1.85);
        tl.call(() => setStatus('Booking window', true), undefined, 2.6);
        // Phase B: vendor booked → the vendor card appears.
        tl.to(panel, { height: H_B, duration: 0.55, ease: 'power2.inOut' }, 3.2);
        tl.to([kids[3], kids[4]], { opacity: 1, duration: 0.5, stagger: 0.06 }, 3.3);
        tl.call(() => setStatus('Vendor booked', false), undefined, 3.5);
        // Phase C: progress + buttons.
        tl.to(panel, { height: H_C, duration: 0.5, ease: 'power2.inOut' }, 4.3);
        tl.to([kids[5], kids[6]], { opacity: 1, duration: 0.5, stagger: 0.08 }, 4.4);
        // Phase D: the "Dispatched by Nova" confirmation.
        tl.to(panel, { height: H_D, duration: 0.5, ease: 'power2.inOut' }, 5.3);
        tl.to([kids[7], kids[8]], { opacity: 1, duration: 0.5, stagger: 0.06 }, 5.4);
        // Panel complete → the remaining left step loads in.
        tl.to(s2, { opacity: 1, y: 0, duration: 0.5 }, 6.1);
        tl.set(panel, { clearProps: 'height' }, 6.7);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { play(); io.disconnect(); }
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setup);
    else setup();
  }
  initUseCase2();

  // ── Use Case 3 (Property Management — Accounts table) choreography ─────────
  // The "Accounts" table has no AGENT column: on scroll-in the accounts come in
  // unassigned, then the Nova agent is added to the LEFT of each row one by one.
  // Left text loads through "Track every account"; the last two steps come in
  // once every account has an agent.
  function initUseCase3() {
    const root = document.querySelector<HTMLElement>('[data-uc3]');
    if (!root) return;
    const panel = root.querySelector<HTMLElement>('.uc-table-panel');
    if (!panel) return;

    // Runs on ALL breakpoints (mobile + desktop); only prefers-reduced-motion
    // opts out. The choreography measures elements live, so it adapts to the
    // panel's size at any width.
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;

    const t = (name: string) => root.querySelector<HTMLElement>(`[data-uc3-t="${name}"]`);
    const title = t('title'), body = t('body'), works = t('works');
    const s1 = t('s1'), s2 = t('s2'), s3 = t('s3');
    const textEls = [title, body, works, s1, s2, s3].filter(Boolean) as HTMLElement[];
    const rows = Array.from(root.querySelectorAll<HTMLElement>('.uc3-row'));
    const avatars = Array.from(root.querySelectorAll<HTMLElement>('.uc3-avatar'));
    const actions = Array.from(root.querySelectorAll<HTMLElement>('.uc3-action'));
    if (rows.length === 0) return;

    let started = false;
    const setup = () => {
      gsap.set(textEls, { opacity: 0, y: 14 });
      gsap.set(panel, { opacity: 0 });
      gsap.set(rows, { opacity: 0, y: 8 });
      gsap.set(avatars, { opacity: 0, scale: 0.4 });
      gsap.set(actions, { opacity: 0 });

      const play = () => {
        if (started) return;
        started = true;
        const tl = gsap.timeline({ defaults: { ease: 'power2.out' } });
        // Glass + table frame (header + column headers) appears.
        tl.to(panel, { opacity: 1, duration: 0.5 }, 0.15);
        // Left text loads in (stops at "Track every account").
        tl.to(title, { opacity: 1, y: 0, duration: 0.5 }, 0.0);
        tl.to(body, { opacity: 1, y: 0, duration: 0.5 }, 0.15);
        tl.to(works, { opacity: 1, y: 0, duration: 0.5 }, 0.3);
        tl.to(s1, { opacity: 1, y: 0, duration: 0.5 }, 0.5);
        // The accounts come in, unassigned.
        tl.to(rows, { opacity: 1, y: 0, duration: 0.45, stagger: 0.16 }, 0.9);
        // Then the Nova agent is added to the left of each request, one by one.
        tl.to(avatars, { opacity: 1, scale: 1, duration: 0.42, stagger: 0.55, ease: 'back.out(1.7)' }, 2.2);
        tl.to(actions, { opacity: 1, duration: 0.4, stagger: 0.55 }, 2.35);
        // Each request runs, then completes — its action flips to the done state
        // (green), one by one, until every request is handled.
        actions.forEach((el, i) => {
          const at = 4.9 + i * 0.35;
          tl.to(el, { opacity: 0.2, duration: 0.18, onComplete: () => { const d = el.getAttribute('data-done'); if (d) el.textContent = d; el.style.color = '#2BA66E'; } }, at);
          tl.to(el, { opacity: 1, duration: 0.3 }, at + 0.18);
        });
        // Every request handled → the remaining left steps load in.
        tl.to(s2, { opacity: 1, y: 0, duration: 0.5 }, 6.5);
        tl.to(s3, { opacity: 1, y: 0, duration: 0.5 }, 6.7);
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) if (e.isIntersecting) { play(); io.disconnect(); }
        },
        { threshold: 0.3 },
      );
      io.observe(root);
    };

    if (document.fonts && document.fonts.ready) document.fonts.ready.then(setup);
    else setup();
  }
  initUseCase3();
</script>
