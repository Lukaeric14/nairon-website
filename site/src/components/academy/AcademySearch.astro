---
// Academy search — fuzzy, client-side, over a JSON index inlined at build time.
//
// 43 lessons is far too small to justify a search service; the whole index is
// ~6KB and Fuse gives typo tolerance ("contxt window" still finds it). The
// results panel is layered over the static lesson grid, which stays in the DOM
// for crawlers regardless of what search is doing.
export interface Props {
  index: Array<{
    slug: string;
    title: string;
    topic: string;
    level: string;
    duration: number;
    youtubeId: string;
    description: string;
  }>;
}
const { index } = Astro.props;
---

<div class="ac-search" data-academy-search>
  <div class="ac-search-field">
    <svg width="15" height="15" viewBox="0 0 16 16" aria-hidden="true" style="flex-shrink: 0;">
      <circle cx="7" cy="7" r="5" fill="none" stroke="#9AA0AC" stroke-width="1.5"></circle>
      <path d="M10.8 10.8 14 14" stroke="#9AA0AC" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
    <input
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-controls="ac-search-results"
      aria-label="Search lessons"
      placeholder="Search lessons — try “context window”"
      autocomplete="off"
      data-search-input
    />
    <kbd class="ac-search-kbd">/</kbd>
  </div>
  <div id="ac-search-results" class="ac-search-results" role="listbox" hidden data-search-results></div>
</div>

<script type="application/json" data-search-index set:html={JSON.stringify(index)}></script>

<style>
  .ac-search {
    position: relative;
    width: 100%;
  }
  .ac-search-field {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid var(--color-hairline);
    border-radius: 10px;
    background-color: #ffffff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ac-search-field:focus-within {
    border-color: var(--color-lapis);
    box-shadow: 0 0 0 3px rgb(15 107 212 / 0.12);
  }
  .ac-search-field input {
    flex-grow: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15px;
  }
  .ac-search-field input::placeholder {
    color: #9aa0ac;
  }
  .ac-search-field input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }
  .ac-search-kbd {
    flex-shrink: 0;
    padding: 2px 7px;
    border: 1px solid var(--color-hairline);
    border-radius: 5px;
    color: #9aa0ac;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 16px;
  }
  .ac-search-field:focus-within .ac-search-kbd {
    display: none;
  }

  .ac-search-results {
    position: absolute;
    z-index: 40;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    max-height: 420px;
    overflow-y: auto;
    padding: 6px;
    box-sizing: border-box;
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    background-color: #ffffff;
    box-shadow: 0 12px 34px rgb(20 23 31 / 0.12);
  }
  .ac-search-results a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 10px;
    border-radius: 8px;
  }
  .ac-search-results a:hover,
  .ac-search-results a[aria-selected='true'] {
    background-color: var(--color-paper-cool);
  }
  .ac-search-thumb {
    width: 56px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 4px;
    object-fit: cover;
    background-color: #0a1322;
  }
  .ac-search-title {
    color: var(--color-ink);
    font-size: 14px;
    font-weight: 500;
    line-height: 19px;
  }
  .ac-search-meta {
    color: #9aa0ac;
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .ac-search-empty {
    padding: 14px 12px;
    color: #5b6170;
    font-size: 14px;
  }
</style>

<script>
  import Fuse from 'fuse.js';

  type Row = {
    slug: string;
    title: string;
    topic: string;
    level: string;
    duration: number;
    youtubeId: string;
    description: string;
  };

  const root = document.querySelector<HTMLElement>('[data-academy-search]');
  const input = root?.querySelector<HTMLInputElement>('[data-search-input]');
  const panel = root?.querySelector<HTMLElement>('[data-search-results]');
  const raw = document.querySelector<HTMLScriptElement>('[data-search-index]')?.textContent;

  if (root && input && panel && raw) {
    const rows: Row[] = JSON.parse(raw);
    const fuse = new Fuse(rows, {
      keys: [
        { name: 'title', weight: 3 },
        { name: 'description', weight: 1.5 },
        { name: 'topic', weight: 1 },
      ],
      threshold: 0.35,
      ignoreLocation: true,
    });

    let active = -1;
    let hits: Row[] = [];

    const close = () => {
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    const render = () => {
      const q = input.value.trim();
      if (!q) return close();

      hits = fuse.search(q, { limit: 8 }).map((r) => r.item);
      if (!hits.length) {
        panel.innerHTML = `<p class="ac-search-empty">No lesson matches “${q.replace(/</g, '&lt;')}”.</p>`;
      } else {
        panel.innerHTML = hits
          .map(
            (h, i) => `
              <a href="/academy/${h.slug}" role="option" aria-selected="${i === active}">
                <img class="ac-search-thumb" src="/academy-thumbs-sm/${h.youtubeId}.jpg" alt="" width="56" height="32" loading="lazy" />
                <span style="display:flex;flex-direction:column;gap:3px;min-width:0;">
                  <span class="ac-search-title">${h.title}</span>
                  <span class="ac-search-meta">${h.topic.replace(/-/g, ' ')} · ${Math.max(1, Math.round(h.duration / 60))} min</span>
                </span>
              </a>`,
          )
          .join('');
      }
      panel.hidden = false;
      input.setAttribute('aria-expanded', 'true');
    };

    input.addEventListener('input', render);
    input.addEventListener('focus', () => input.value.trim() && render());

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return close();
      if (!hits.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        active = e.key === 'ArrowDown' ? Math.min(active + 1, hits.length - 1) : Math.max(active - 1, 0);
        render();
        panel.querySelectorAll('a')[active]?.scrollIntoView({ block: 'nearest' });
      }
      if (e.key === 'Enter' && active >= 0) {
        e.preventDefault();
        window.location.href = `/academy/${hits[active].slug}`;
      }
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    // "/" focuses search, the way every docs site the reader already uses does.
    document.addEventListener('keydown', (e) => {
      const el = document.activeElement;
      const typing = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement;
      if (e.key === '/' && !typing) {
        e.preventDefault();
        input.focus();
      }
    });
  }
</script>
