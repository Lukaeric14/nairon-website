---
// In-article lead-magnet CTA — the one filled-Lapis moment on a lesson page.
// Links to the magnet's /go funnel rather than the file, so the lead is
// captured wherever the reader came from.
import { type CollectionEntry } from 'astro:content';

export interface Props {
  magnet: CollectionEntry<'magnets'>;
}
const { magnet } = Astro.props;
const m = magnet.data;
---

<aside class="magnet" data-reveal>
  <div class="magnet-copy">
    <p class="magnet-kicker">Free download</p>
    <p class="magnet-title">{m.title}</p>
    <p class="magnet-body">{m.subhead}</p>
  </div>
  <a class="magnet-cta" href={`/go/${magnet.id}`} data-magnet={magnet.id}>
    <span>Get the guide</span>
    <span class="magnet-cta-dot" aria-hidden="true">
      <svg width="10" height="10" viewBox="0 0 10 10">
        <path d="M2 5h5.5M5 2.2 7.8 5 5 7.8" fill="none" stroke="var(--color-lapis)" stroke-width="1.3" stroke-linecap="square"></path>
      </svg>
    </span>
  </a>
</aside>

<style>
  .magnet {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    margin-top: 56px;
    padding: 28px 30px;
    background-color: #091f40;
    border-radius: 14px;
    box-sizing: border-box;
  }
  @media (min-width: 640px) {
    .magnet {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
  }
  .magnet-copy {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex-grow: 1;
    min-width: 0;
  }
  .magnet-kicker {
    margin: 0;
    color: var(--color-lapis-300);
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .magnet-title {
    margin: 0;
    color: #fbfaf6;
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 25px;
  }
  .magnet-body {
    margin: 0;
    max-width: 380px;
    color: #9fb0c6;
    font-size: 14px;
    line-height: 20px;
  }
  .magnet-cta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    padding: 11px 12px 11px 20px;
    border-radius: 48px;
    background-color: var(--color-lapis);
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    transition: background-color 0.15s ease;
  }
  .magnet-cta:hover {
    background-color: #0b5cbb;
  }
  .magnet-cta-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    border-radius: 999px;
    background-color: #ffffff;
  }
</style>
