---
// Page.astro — shared layout for every supporting page (legal, company, trust,
// training, 404). Wraps Base with the sticky nav (solid variant, since these
// pages start on white), a standard title block, a body slot, and the footer.
// Content pages render their body inside <div class="page-body"> using the
// .page-prose / .page-grid / .page-card / .page-section helpers in global.css.
import Base from './Base.astro';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';

export interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  heading: string;
  intro?: string;
  updated?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, eyebrow, heading, intro, updated, image, jsonLd } = Astro.props;
---

<Base title={title} description={description} image={image} jsonLd={jsonLd}>
  <Nav solid />
  <main class="page-main">
    <header class="page-header" data-reveal-group>
      {eyebrow && (
        <div data-reveal class="page-eyebrow"><span class="page-eyebrow-dot"></span>{eyebrow}</div>
      )}
      <h1 data-reveal class="page-h1">{heading}</h1>
      {intro && <p data-reveal class="page-lead">{intro}</p>}
      {updated && <p data-reveal class="page-updated">Last updated {updated}</p>}
    </header>
    <slot />
  </main>
  <Footer />
</Base>
